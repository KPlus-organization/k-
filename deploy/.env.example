# Copy to /opt/k-/.env on the server and fill in. Never commit the real file.

# Where the deploy workflow publishes images: ghcr.io/<GitHub owner in lowercase>.
IMAGE_PREFIX=ghcr.io/lisgolub

# Port the site is served on. 80 opens as http://<IP>/, any other as http://<IP>:<port>/.
WEB_PORT=80

# Exactly the address typed in the browser: scheme + host + port (omit :80).
# Several addresses (e.g. IP and later a domain) are comma-separated.
SITE_ORIGIN=http://203.0.113.10

# Database password. Letters and digits only, it is inserted into a URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
