# Copy to /opt/k-/.env on the server and fill in. Never commit the real file.

# Where the deploy workflow publishes images: ghcr.io/<GitHub owner in lowercase>.
# Deploys pass it themselves; this value is for manual docker compose commands.
IMAGE_PREFIX=ghcr.io/kplus-organization

# Domain of the site, without scheme. Its A record must point to the server:
# Caddy gets the HTTPS certificate for it. www.<domain> and the IP redirect here.
SITE_DOMAIN=moepravoplus.ru

# Ports on the server for HTTP and HTTPS. Let's Encrypt needs the defaults 80 and 443.
WEB_PORT=80
HTTPS_PORT=443

# Exactly the address in the browser: scheme + host + port (omit :443).
# Several addresses are comma-separated.
SITE_ORIGIN=https://moepravoplus.ru

# Database password. Letters and digits only, it is inserted into a URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
