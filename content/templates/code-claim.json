      "options": [
        {
          "value": "order",
          "label": "Договор заказа"
        },
        {
          "value": "work",
          "label": "Договор подряда"
        },
        {
          "value": "other",
          "label": "Иной договор"
        }
      ],
      "when": {
        "rightsBasis": "order"
      }
    },
    {
      "id": "rightsContractNumber",
      "group": "rights",
      "label": "Номер договора о правах",
      "type": "text",
      "required": true,
      "maxLength": 300,
      "when": {
        "rightsBasis": [
          "assignment",
          "order",
          "exclusive"
        ]
      }
    },
    {
      "id": "rightsContractDate",
      "group": "rights",
      "label": "Дата договора о правах",
      "type": "date",
      "required": true,
      "maxLength": 300,
      "when": {
        "rightsBasis": [
          "assignment",
          "order",
          "exclusive"
        ]
      }
    },
    {
