{
  "id": "code-claim",
  "version": 1,
  "kind": "claim",
  "object": "code",
  "title": "Претензия о нарушении прав на программный код",
  "description": "Заполните сведения о сторонах, правах, обстоятельствах и требованиях. Текст составляется по предоставленному шаблону.",
  "groups": [
    {
      "id": "parties",
      "title": "1. Стороны и программа",
      "description": "Укажите лицо, которому принадлежат права, и адресата претензии."
    },
    {
      "id": "rights",
      "title": "2. Принадлежность прав",
      "description": "Выберите основание и перечислите подтверждающие документы."
    },
    {
      "id": "violation",
      "title": "3. Обстоятельства нарушения",
      "description": "Укажите только фактически установленные действия и доказательства."
    },
    {
      "id": "requirements",
      "title": "4. Требования о прекращении нарушения",
      "description": "Включите только применимые к вашей ситуации требования."
    },
    {
      "id": "money",
      "title": "5. Денежное требование",
      "description": "Выберите один вариант. Убытки и компенсация за одно нарушение не складываются."
    },
    {
      "id": "payment",
      "title": "6. Реквизиты для выплаты",
      "description": "Этот раздел появляется только при денежном требовании."
    },
    {
      "id": "response",
      "title": "7. Ответ и подпись",
      "description": "Подготовленный файл можно распечатать и подписать."
    },
    {
      "id": "attachments",
      "title": "8. Приложения",
      "description": "Впишите только документы, которые действительно будете направлять. Файлы здесь не загружаются."
    }
  ],
  "fields": [
    {
      "id": "applicantType",
      "group": "parties",
      "label": "Кто обращается",
      "type": "select",
      "required": true,
      "maxLength": 300,
      "options": [
        {
          "value": "person",
          "label": "Физическое лицо / ИП"
        },
        {
          "value": "company",
          "label": "Организация"
        }
      ]
    },
    {
      "id": "recipient",
      "group": "parties",
      "label": "Кому: Ф. И. О. или наименование",
