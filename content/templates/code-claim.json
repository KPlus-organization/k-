      "required": true,
      "maxLength": 300
    },
    {
      "id": "recipientAddress",
      "group": "parties",
      "label": "Адрес получателя",
      "type": "textarea",
      "required": true,
      "maxLength": 2000
    },
    {
      "id": "recipientIdentifiers",
      "group": "parties",
      "label": "Известные идентификаторы получателя",
      "type": "text",
      "required": false,
      "maxLength": 300,
      "hint": "ИНН, ОГРН или иные известные сведения."
    },
    {
      "id": "applicant",
