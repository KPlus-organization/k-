    },
    {
      "id": "rightsBasis",
      "group": "rights",
      "label": "На каком основании возникли права",
      "type": "select",
      "required": true,
      "maxLength": 300,
      "options": [
        {
          "value": "author",
          "label": "Программа создана лично",
          "text": "Программа создана заявителем лично."
        },
        {
          "value": "employer",
          "label": "Программа создана работником",
          "text": "Программа создана работником в пределах трудовых обязанностей; исключительное право принадлежит работодателю при соблюдении условий статьи 1295 ГК РФ."
        },
        {
          "value": "assignment",
          "label": "Договор отчуждения исключительного права",
          "text": "Исключительное право приобретено по договору отчуждения."
        },
        {
          "value": "order",
          "label": "Договор заказа / подряда / иной договор",
          "text": "Право возникло в силу договора с учетом применимых положений статей 1296, 1297 ГК РФ."
        },
        {
          "value": "exclusive",
          "label": "Исключительная лицензия",
          "text": "Заявитель является исключительным лицензиатом и вправе защищать право в пределах статьи 1254 ГК РФ."
        }
      ]
    },
    {
      "id": "rightsContractType",
      "group": "rights",
      "label": "Вид договора о приобретении прав",
      "type": "select",
      "required": true,
