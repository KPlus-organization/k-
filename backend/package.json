{
  "name": "k-",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the web application (TypeScript, Express, PostgreSQL)",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LisGolub/k-.git"
  },
  "bugs": {
    "url": "https://github.com/LisGolub/k-/issues"
  },
  "homepage": "https://github.com/LisGolub/k-#readme",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
