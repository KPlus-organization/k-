# Copy to .env and adjust: cp .env.example .env
# Never commit .env — it is ignored by Git.

# development | production | test
NODE_ENV=development

# HTTP port of the backend (default: 3001)
PORT=3001

# PostgreSQL connection string (required):
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode special characters in the password (e.g. @ -> %40).
# For TLS add a query parameter, e.g. ?sslmode=require
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db

# Exact origin of the frontend allowed by CORS (scheme + host + port, no path)
FRONTEND_ORIGIN=http://localhost:3000
