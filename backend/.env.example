# Copy to .env and adjust: cp .env.example .env
# Never commit .env — it is ignored by Git.

# development | production | test
NODE_ENV=development

# HTTP port of the backend (default: 3001)
PORT=3001

# PostgreSQL connection string (required):
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode special characters in the password (e.g. @ -> %40).
# For TLS add a query parameter, e.g. ?sslmode=require
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db

# Frontend origins allowed by CORS, comma-separated (scheme + host + port, no path).
# The frontend dev server listens on 127.0.0.1:3000, so both spellings are listed.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Secret for signing JWT access tokens (required, at least 32 characters).
# Generate one: openssl rand -base64 48
JWT_SECRET=

# Access token lifetime in seconds (default: 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_TTL_DAYS=30

# Site content directory, relative to backend/ (default: ../content).
# CONTENT_DIR=../content

# For `npm run db:seed:demo` only (development and CI): password of the demo user
# anna_kuznetsova, at least 8 characters. Never used in production.
SEED_DEMO_PASSWORD=
